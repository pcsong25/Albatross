.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Derived output. The LaTeX document is regenerated from the node files on
# demand and is never the source of truth, so it does not belong in history.
.bp/build/

# Everything else under .bp/ — events.jsonl, and the agent call log once L1
# lands — is history and IS tracked.

.DS_Store

# Vendored front-end libraries. `bp ui --vendor` fetches them (23 files, ~1 MB)
# for working offline; the page falls back to a CDN when they are absent. Third-
# party minified builds and fonts do not belong in a mathematics project's history.
bp/ui/static/vendor/
