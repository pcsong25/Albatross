((* if not clean *))
% --- status apparatus: present only because parts of this document are not yet
% --- proved. `bp render --clean` omits all of it.
\newsavebox{\bpboxreg}
\newenvironment{bpbox}%
  {\par\medskip\noindent\begin{lrbox}{\bpboxreg}%
   \begin{minipage}{\dimexpr\linewidth-2\fboxsep-2\fboxrule\relax}}%
  {\end{minipage}\end{lrbox}\noindent\fbox{\usebox{\bpboxreg}}\par\medskip}
\newcommand{\bpmark}[3]{%
  \par\noindent{\small\colorbox{#1!15}{\textcolor{#1!65!black}{\textbf{\,#2\,}}}%
  \hspace{0.5em}\textcolor{#1!55!black}{#3}}\par\nobreak\smallskip}
\newcommand{\bphyp}[1]{\par\noindent{\small\textit{Hypotheses.} #1}\par\smallskip}
\newcommand{\bpaudit}[1]{\par\noindent{\footnotesize\textcolor{Gray}{#1}}\par\smallskip}
((* else *))
\newsavebox{\bpboxreg}
\newenvironment{bpbox}%
